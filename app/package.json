{
  "name": "teamroom",
  "private": true,
  "version": "0.1.0",
  "description": "HCL Domino TeamRoom replatformed as a React + Fastify + SQLite app",
  "packageManager": "pnpm@10.33.4",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @teamroom/api --filter @teamroom/web dev",
    "build": "pnpm --filter @teamroom/web build && pnpm --filter @teamroom/api build",
    "start": "pnpm --filter @teamroom/api start",
    "test": "pnpm --filter @teamroom/api test",
    "typecheck": "pnpm -r typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
